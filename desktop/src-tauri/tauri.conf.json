{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNASeek视频解析",
  "version": "0.1.0",
  "identifier": "com.valenbine.vnaseek",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VNASeek视频解析",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../resources/**",
      "../../beat_analyzer/**"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
